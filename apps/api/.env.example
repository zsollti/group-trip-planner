# Copy to .env and adjust. .env is gitignored.
#
# Local Postgres via the bundled docker-compose (from repo root):
#   docker compose up -d db
# then this connection string works as-is:
DATABASE_URL="postgresql://gtp:gtp_dev_password@localhost:5432/gtp_dev?schema=public"

# If you use a managed dev database (e.g. Neon/Supabase) instead of Docker,
# paste its connection string here. For Neon, append: &sslmode=require

# --- Required: signs the short-lived access JWT (min 16 chars) ---
JWT_SECRET="change-me-to-a-long-random-secret"

# --- Optional (defaults shown; validated at startup, see src/config/env.ts) ---
# NODE_ENV=development             # development | test | production
# PORT=3000                        # HTTP port
# LOG_LEVEL=info                   # fatal|error|warn|info|debug|trace|silent

# Auth token lifetimes
# JWT_ACCESS_TTL=15m               # access-token lifetime (ms/s/m/h/d)
# REFRESH_TOKEN_TTL_DAYS=30        # refresh-token lifetime
# EMAIL_VERIFICATION_TTL_HOURS=24  # verification-link lifetime

# Refresh-cookie transport (Secure defaults on in production)
# COOKIE_SECURE=true               # override the NODE_ENV-based default
# COOKIE_SAMESITE=lax              # lax | strict | none
# COOKIE_DOMAIN=                   # e.g. .example.com for cross-subdomain

# CORS: comma-separated frontend origins allowed to send credentials
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Google OAuth (Phase 1.0). Set ALL THREE to enable "Continue with Google";
# leave unset and the /auth/google routes 404 (email/password still works).
# Create the credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# The callback URL must match the "Authorized redirect URI" byte-for-byte:
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email (Resend). Without a key, verification links are logged to the console.
# RESEND_API_KEY=
# EMAIL_FROM=Group Trip Planner <onboarding@resend.dev>
# Where emailed links point (verification, unsubscribe landing). Defaults to
# web-board — the Phase-3.5 winner; deck/feed are frozen.
# WEB_APP_URL=http://localhost:5175
# The API's own public base URL — unsubscribe links are clicked from a mail
# client with no session, so they hit the API directly, not the SPA.
# API_PUBLIC_URL=http://localhost:3000

# Rate limiting (global floor; auth routes tighten per-route)
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=100

# Error reporting (Phase 7.5). Entirely opt-in: with no DSN the Sentry SDK is
# never initialised and nothing is sent, which is why local dev and CI leave it
# unset. Read directly by src/observability/instrument.ts, which runs before
# this contract is parsed.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production      # defaults to NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0        # 0..1; errors are the point, spans cost quota

# Image uploads (Phase 6.1). Local-disk storage stands in for Cloudflare R2;
# swapping the driver is a provider change, the pipeline above it is identical.
# UPLOAD_DIR must sit outside anything served as a web root — bytes only come
# back out through GET /media/:name, which fixes the content type and sends
# nosniff.
# A relative UPLOAD_DIR resolves against the process working directory, so
# launching the API from the repo root and from apps/api gives you two different
# stores. Both are gitignored; set an absolute path anywhere it matters.
# In production the app REFUSES to start on a relative path: a container's own
# filesystem is discarded on redeploy, so it must point at a mounted volume
# (the deployed value is /data/uploads — see DEPLOY.md).
# UPLOAD_DIR=./var/uploads
# UPLOAD_MAX_BYTES=5242880
# UPLOAD_MAX_DIMENSION=2048
