// Prisma schema.
// Phase 0.4 added the auth identity tables; Phase 1.1 adds the Trip +
// TripMembership spine. The rest of the domain (Category, Option, ...) lands in
// later phases as vertical slices. Table names are snake_case; app-facing IDs
// are UUIDs; secrets are stored hashed, never in the clear.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  displayName    String
  // Nullable: OAuth-only accounts (Google, Phase 1.0) have no local password.
  passwordHash   String?
  emailVerified  Boolean   @default(false)
  // Profile picture (Phase 6.2). Null means "no picture" — the front-end draws
  // generated initials rather than shipping a stock silhouette. Always a URL
  // this service issued: uploads go through the Phase-6.1 pipeline, never a
  // client-supplied address. Purged on GDPR anonymization along with the object.
  avatarUrl      String?
  // Notification-email preference (Phase 5.2, FR-36): global "email me when I'm
  // @mentioned". Defaults on — the feature is opt-out, and the unsubscribe link
  // in every notification email flips exactly this flag. Gates the notification
  // channel ONLY; transactional mail ignores it.
  emailOnMention Boolean   @default(true)
  // The language this account reads the interface in (post-launch). Text with a
  // default rather than a Postgres enum, so offering another language is a
  // dictionary and a one-line contract change instead of a migration on a type —
  // the same reasoning as `admin_audit_events.action`. Validated on the way in
  // and on the way out against the shared `LOCALES`, so a value this build does
  // not offer can neither be stored nor rendered.
  locale         String    @default("en")
  // App-wide suspension (post-launch), set from the operator's console. Three
  // columns and not one, because "is it on", "when does it end" and "why" are
  // three different answers — see `packages/types/src/ban.ts` for the modelling
  // note, including why a null `bannedUntil` beside a set `bannedAt` means
  // permanent rather than "no end recorded". A lapsed ban is evaluated as over
  // on read; the row is kept so the console can still say what happened.
  bannedAt       DateTime?
  bannedUntil    DateTime?
  banReason      String?
  // When this account finished or dismissed the guided tour (post-launch), or
  // null if it never has. On the account rather than in the browser because
  // "skippable, but available later" needs somewhere stable: a per-browser flag
  // means the tour ambushes the same person again from their phone. A timestamp
  // rather than a boolean because the two cost the same and only one of them can
  // answer a question later.
  tourCompletedAt DateTime?
  // The same for the overview's two-step tour, counted separately: the two are
  // different tours, and the overview's last word is a promise to show the
  // reader around the first board they make. One shared flag would have the
  // overview tour switch the board tour off on its way out.
  overviewTourCompletedAt DateTime?
  // GDPR erasure (FR-6): set on anonymization; personal fields are purged.
  anonymizedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedTrips              Trip[]                   @relation("TripOwner")
  memberships             TripMembership[]
  createdInvites          InviteLink[]             @relation("InviteCreator")
  blocks                  TripBlock[]              @relation("BlockedUser")
  blocksIssued            TripBlock[]              @relation("BlockIssuer")
  proposedOptions         Option[]                 @relation("OptionProposer")
  lockedOptions           Option[]                 @relation("OptionLocker")
  votes                   Vote[]
  optionParticipations    OptionParticipant[]
  auditEvents             AuditEvent[]             @relation("AuditActor")
  messages                Message[]                @relation("MessageAuthor")
  deletedMessages         Message[]                @relation("MessageDeleter")
  reactions               Reaction[]
  mentions                Mention[]
  channelReads            ChannelRead[]
  notifications           Notification[]
  emailJobs               EmailJob[]

  @@map("users")
}

/// Role hierarchy within a trip: Owner > Co-organizer > Participant > Guest
/// (SRS §3). Visitor is NOT a role — it is the unauthenticated public-preview
/// scope and has no membership row.
enum TripRole {
  OWNER
  CO_ORGANIZER
  PARTICIPANT
  GUEST
}

/// Active trips accept planning mutations; History trips are frozen (the
/// lifecycle transition itself lands in Phase 2).
enum TripStatus {
  ACTIVE
  HISTORY
}

/// How an option's `amount` is interpreted against its headcount (SRS FR-21/26).
/// `PER_PERSON`: amount is each traveller's share (group = amount × headcount).
/// `TOTAL`: amount is the whole cost (per-head = amount ÷ headcount). The pure
/// cost engine (Phase 3) interprets these; Phase 2 only stores them.
enum CostType {
  PER_PERSON
  TOTAL
}

/// Lifecycle of a proposed option (SRS FR-21/24). `PROPOSED` is the default;
/// `LOCKED` is the audited decision state reached via the atomic lock (Phase
/// 2.4). A locked option cannot be edited — it must be unlocked first (FR-24).
enum OptionStatus {
  PROPOSED
  LOCKED
}

/// Stable identity for a seeded built-in category (Phase 2.1). Categories are
/// renamable and deletable (FR-18), so `name` can neither identify the Dates
/// category for date write-back (Phase 2.5) nor drive the default `singleChoice`
/// flag — `builtinKey` survives a rename and is null for custom categories.
enum CategoryBuiltinKey {
  DATES
  TRANSPORT
  ACCOMMODATION
  ACTIVITIES
  BUDGET
}

/// Which of the board's colour palettes a category wears (post-launch).
///
/// A key, never a colour: the hues and the light/dark treatment of each are the
/// front-end's business, so retuning a palette is a stylesheet edit rather than
/// a data migration. Null means "the default this category has always had",
/// which the board derives from `builtinKey` or the id - so the column is empty
/// for every category nobody has repainted, and that is the normal state.
enum CategoryPalette {
  AMBER
  GOLD
  LIME
  JADE
  SKY
  INDIGO
  VIOLET
  ROSE
}

/// A trip's chat channel kind (Phase 4.1, FR-29). `GENERAL` is auto-created with
/// the trip; `CATEGORY` channels are created on demand (Phase 4.5) and cascade
/// when their category is deleted.
enum ChannelType {
  GENERAL
  CATEGORY
}

model Trip {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  destination         String?
  /// The place the destination was chosen from, when it was chosen rather than
  /// typed. `destination` stays the display string and stays free text — a group
  /// going to "Dad's cabin" or "the Dolomites" must not be turned away by a
  /// gazetteer — so this is the *additional* fact that it resolved to somewhere
  /// known.
  ///
  /// **Deliberately not a foreign key.** The places table is a seeded snapshot
  /// that gets rebuilt from a newer dump; a constraint would make re-seeding able
  /// to fail on live trips, and a cascade would make it able to edit them. This
  /// is a reference to an external identifier that happens to be cached locally.
  destinationPlaceId  Int?
  /// Copied from the place at the moment it was chosen, not joined on read.
  ///
  /// The same reasoning as `defaultCurrency`: once a trip is being planned
  /// around a clock, that clock is part of the trip's own data, and it must not
  /// change because a re-seed corrected a row underneath it.
  destinationLat      Float?
  destinationLon      Float?
  destinationTimezone String?
  // The safe upload pipeline is Phase 6; the column exists now so nothing has
  // to be retrofitted. Always null until then.
  coverImageUrl       String?
  defaultCurrency     String     @default("EUR")
  // What the group is aiming to spend each, in `defaultCurrency`. A target the
  // totals are read against, never a constraint — nothing validates against it
  // and no option is refused for exceeding it. It lives here, not in a lane,
  // because a budget is not a candidate you vote between (the retired Budget
  // category is written up in docs/decisions.md). Same precision as
  // `Option.amount`, so a target and the figures it is compared with round the
  // same way.
  budgetPerPerson     Decimal?   @db.Decimal(12, 2)
  // Dates are written back when a Dates-category option is locked (Phase 2);
  // until then a trip carries no dates and the created+1yr `expiresAt` fallback.
  startDate           DateTime?  @db.Date
  endDate             DateTime?  @db.Date
  expiresAt           DateTime
  status              TripStatus @default(ACTIVE)
  // Denormalized owner (SRS §6). The owner also holds an OWNER membership row;
  // both are written in one transaction at creation.
  ownerId             String     @db.Uuid
  // Optimistic-concurrency token for the "changed since you opened it — reload"
  // edit path (SRS §6). Bumped on every trip-detail edit.
  version             Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  owner         User             @relation("TripOwner", fields: [ownerId], references: [id])
  memberships   TripMembership[]
  invites       InviteLink[]
  blocks        TripBlock[]
  categories    Category[]
  auditEvents   AuditEvent[]
  channels      Channel[]
  notifications Notification[]

  @@index([ownerId])
  @@map("trips")
}

/// A planning category within a trip (SRS §6, Phase 2.1). A trip is seeded with
/// five built-ins at creation (Dates, Transport, Accommodation, Activities,
/// Budget); Organizers may add custom ones. `singleChoice` means locking one
/// option unlocks its siblings (FR-19) — the category-level lock in Phase 2.4 is
/// serialized by `version`. Deleting a category hard-cascades its options, votes,
/// and (Phase 4) chat channel (FR-20). `position` orders the categories.
model Category {
  id           String              @id @default(uuid()) @db.Uuid
  tripId       String              @db.Uuid
  name         String
  // Single-choice categories (e.g. Dates) allow only one locked option at a
  // time; multi-select (e.g. Transport) allow many. FR-19.
  singleChoice Boolean             @default(false)
  // True for the five seeded built-ins; they are renamable/reorderable but the
  // key below preserves their identity for date write-back (Phase 2.5).
  isBuiltin    Boolean             @default(false)
  builtinKey   CategoryBuiltinKey?
  // The palette an organizer chose for this lane, or null for the derived
  // default. Shared state on purpose: a colour picked by one member is what the
  // whole trip sees, because the lane's colour is how everyone recognises it.
  paletteKey   CategoryPalette?
  position     Int
  // Optimistic-concurrency token. Rename uses it for the "changed since you
  // opened it — reload" path; the Phase-2.4 single-choice lock guards on it to
  // serialize the one-decision-per-category race (FR-24).
  version      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  options Option[]
  channel Channel?

  // A trip has at most one category per built-in key (the seed is idempotent by
  // construction); custom categories carry a null key and are unconstrained.
  @@unique([tripId, builtinKey])
  @@index([tripId])
  @@map("categories")
}

/// A per-trip chat channel (Phase 4.1, SRS §6 / FR-29). Every trip has exactly
/// one auto-created `GENERAL` channel; `CATEGORY` channels are created on demand
/// (Phase 4.5) and are 1:1 with their category (`categoryId` unique), cascading
/// when the category is deleted. Messages/reactions/reads hang off a channel in
/// later 4.x slices.
model Channel {
  id         String      @id @default(uuid()) @db.Uuid
  tripId     String      @db.Uuid
  // Null for the GENERAL channel; the owning category for a CATEGORY channel.
  categoryId String?     @unique @db.Uuid
  type       ChannelType
  createdAt  DateTime    @default(now())

  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    ChannelRead[]

  @@index([tripId])
  @@map("channels")
}

/// Per-user read cursor for a channel (Phase 4.4, FR-32). `lastReadAt` advances
/// when the member views the channel; the unread count is the messages after it
/// authored by someone else. One row per (channel, user); cascades on channel or
/// user delete.
model ChannelRead {
  id         String   @id @default(uuid()) @db.Uuid
  channelId  String   @db.Uuid
  userId     String   @db.Uuid
  lastReadAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_reads")
}

/// A chat message in a channel (Phase 4.2, SRS §6 / FR-30). Messages are
/// **soft-deleted** (`deletedAt` + `deletedById`) so a tombstone survives in
/// history — the author may delete their own, an Organizer anyone's. Posting is
/// allowed for every member and is **exempt from the History freeze** (chat stays
/// open in ended trips, FR-10). Ordered by `createdAt` for cursor-paged history
/// and the Phase-4.4 reconnect catch-up.
model Message {
  id          String    @id @default(uuid()) @db.Uuid
  // Monotonic insert order (Phase 4.4). `createdAt` is millisecond-precision, so
  // rapid messages can tie; `seq` gives a total, gap-free order that makes the
  // reconnect "messages since <id>" catch-up reliable (no gaps, no dupes).
  seq         Int       @unique @default(autoincrement())
  channelId   String    @db.Uuid
  authorId    String    @db.Uuid
  body        String
  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User       @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy User?      @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  reactions Reaction[]
  mentions  Mention[]

  @@index([channelId, createdAt])
  @@index([authorId])
  @@index([deletedById])
  @@map("messages")
}

/// A public emoji reaction on a message (Phase 4.3, FR-31). One row per
/// (message, user, emoji) — a member may react with several distinct emoji, and
/// reacting is idempotent (toggle add/remove). Cascades on message or user
/// delete. Reactions are advisory decoration and are never frozen by lifecycle.
model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("reactions")
}

/// A resolved `@mention` target on a message (Phase 4.3, FR-32). Parsed and
/// validated server-side against the trip's members at post time; **persisted so
/// Phase 5 can turn it into a notification** (delivery is deferred). One row per
/// (message, mentioned user). Cascades on message or user delete.
model Mention {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("mentions")
}

/// What happened, for a {@link Notification} (Phase 5.1). One value per trigger
/// in SRS §Phase-5: a member proposed an option, an organizer locked a decision,
/// or someone `@mentioned` you in chat. The type drives both the rendered copy
/// and (from 5.2) whether an email is enqueued — only MENTION ever emails.
enum NotificationType {
  OPTION_PROPOSED
  OPTION_LOCKED
  MENTION
}

/// A per-recipient in-app notification (Phase 5.1). Fan-out is **materialized**:
/// one row per recipient, written after the triggering action has committed, so
/// a notification failure can never roll back a lock or a message. The actor is
/// never a recipient of their own action (decision 2).
///
/// `payload` is a **denormalized snapshot** (trip name, actor name, subject
/// title) taken at fan-out time, for the same reason {@link AuditEvent.metadata}
/// is: the bell must render without re-reading a subject that may since have been
/// edited, soft-deleted, or renamed — and without an N+1 join per row. `readAt`
/// null = unread; marking read is idempotent and never deletes the row.
///
/// Rows are scoped to a trip so leaving/losing access takes its notifications
/// with it (cascade), and so 5.3's per-trip mute has something to filter on.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  tripId    String           @db.Uuid
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // The bell's two queries: the newest-first page and the unread count, both
  // always scoped to one user.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([tripId])
  @@map("notifications")
}

/// Lifecycle of a queued notification email (Phase 5.2). See `@gtp/types`
/// `EmailJobStatus` for the state machine; SENDING is persisted so a worker that
/// dies mid-send leaves a reclaimable row rather than a lost email.
enum EmailJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// What a queued email is about (Phase 5.2). Only MENTION today: it is the sole
/// SRS Phase-5 trigger with an email channel — proposals and locks stay in-app,
/// so an active trip cannot become a mail flood.
enum EmailJobType {
  MENTION
}

/// A queued **notification** email (Phase 5.2, FR-35). Transactional mail
/// (verification, "account exists") never lands here — it is sent inline on a
/// strictly separate path and is never preference-gated (FR-36).
///
/// The queue is DB-backed rather than in-memory so a restart cannot drop mail,
/// and so idempotency is enforced by the database instead of by hope:
/// `dedupeKey` is UNIQUE, so a retried fan-out or a redelivered event inserts
/// nothing the second time and the recipient gets **exactly one** email.
///
/// `payload` is a denormalized snapshot for the same reason
/// {@link Notification.payload} is — the mail must render from the row alone,
/// long after the message was edited or the trip renamed — and `to` snapshots
/// the address so a queued email cannot be redirected by a later address change.
///
/// Preference gating happens at **enqueue** time, so everything in this table is
/// mail that is meant to go out; the worker's only job is delivery + retry.
model EmailJob {
  id        String         @id @default(uuid()) @db.Uuid
  /// Idempotency key: `<type>:<eventId>:<recipientId>` (`emailDedupeKey`).
  dedupeKey String         @unique
  type      EmailJobType
  status    EmailJobStatus @default(PENDING)
  /// Snapshotted recipient address (see model doc).
  to        String
  /// Nullable so a deleted account's in-flight job is dropped, not orphaned.
  userId    String?        @db.Uuid
  payload   Json
  attempts  Int            @default(0)
  /// Not eligible for a worker pass before this instant — the backoff schedule.
  runAfter  DateTime       @default(now())
  /// When the current SENDING claim was taken; drives stale-claim reclaim.
  claimedAt DateTime?
  lastError String?
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The worker's only query: due work, oldest first.
  @@index([status, runAfter])
  @@index([userId])
  @@map("email_jobs")
}

/// A proposal within a category (SRS §6 / FR-21, Phase 2.2). Options are
/// **soft-deleted** (`deletedAt`) so votes and audit history survive. The cost
/// fields (`amount`/`currency`/`costType`/`headcount`/`headcountIsFixed`) feed the
/// Phase-3 cost engine unchanged; `startsAt`/`endsAt` are the future timeline and
/// `externalRef` a future booking hook. `version` is the optimistic-concurrency
/// token used both for edits ("reload") and the Phase-2.4 atomic lock
/// (compare-and-set). `materialChangedAt` is stamped when a **cost- or
/// date-affecting** field changes, which flags prior votes stale without
/// deleting them (FR-23, decision 3); it is null until the first material edit.
model Option {
  id                String            @id @default(uuid()) @db.Uuid
  categoryId        String            @db.Uuid
  proposerId        String            @db.Uuid
  title             String
  description       String?
  url               String?
  // Money is stored as an exact decimal (no float drift); null = unpriced.
  amount            Decimal?          @db.Decimal(12, 2)
  currency          String
  costType          CostType          @default(PER_PERSON)
  // Who this option is priced for. WHOLE_GROUP resolves to the trip's live
  // member count (the old dynamic headcount); OPT_IN counts the `participants`
  // rows instead. This replaces the stored `headcount`/`headcountIsFixed`
  // pair — a typed number could not notice a member leaving, which is the
  // entire reason `headcountConfirmedAt` and the staleness rule existed.
  participationMode ParticipationMode @default(WHOLE_GROUP)
  startsAt          DateTime?
  endsAt            DateTime?
  externalRef       String?
  // Manual display order within the category (Phase 3.5, board drag-and-drop).
  // Organizer-reorderable; new options append at the end. **Display-only** — it
  // never affects votes, cost, or the projection front-runner (which tiebreaks
  // votes → createdAt → id, not position).
  position          Int               @default(0)
  status            OptionStatus      @default(PROPOSED)
  version           Int               @default(0)
  materialChangedAt DateTime?
  // Set atomically when the option is locked (Phase 2.4, FR-24); cleared on
  // unlock. `lockedById` is a nullable soft reference (onDelete: SetNull) so a
  // locker's account deletion never erases the decision.
  lockedById        String?           @db.Uuid
  lockedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  category     Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  proposer     User                @relation("OptionProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  lockedBy     User?               @relation("OptionLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  votes        Vote[]
  participants OptionParticipant[]

  @@index([categoryId])
  @@index([proposerId])
  @@index([lockedById])
  @@map("options")
}

/// Who an option is priced for (post-launch, replacing the fixed headcount).
enum ParticipationMode {
  /// Everyone on the trip; the headcount is the live member count.
  WHOLE_GROUP
  /// Only the members who said they are in — the `option_participants` rows.
  OPT_IN
}

/// One member opting in to an OPT_IN option — "I am in for this".
///
/// Deliberately the same shape as {@link Vote}, because it is the same kind of
/// fact: one row per member per option, written and withdrawn by that member
/// alone. It replaces a number somebody typed, and the difference is that this
/// one can be verified — four faces are four people, where "4" was a claim
/// nobody could check and nothing could keep current.
model OptionParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  optionId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per member per option; joining is idempotent (upsert). The index
  // serves the per-option participant read, exactly as votes' does.
  @@unique([optionId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("option_participants")
}

/// The audited actions recorded on the trip's activity log (FR-33). Phase 2.4
/// wrote the option decisions; Phase 5.4 retrofits the membership actions at the
/// source, so the feed is a read of this log rather than a second story about
/// what happened. The enum is open to extension — never renumbered.
enum AuditAction {
  OPTION_LOCKED
  OPTION_UNLOCKED
  MEMBER_ROLE_CHANGED
  MEMBER_KICKED
  MEMBER_BLOCKED
  MEMBER_UNBLOCKED
  MEMBER_LEFT
  OWNERSHIP_TRANSFERRED
}

/// An immutable record of a significant trip action (SRS §6 / FR-33, Phase 2.4).
/// Written **inside the same transaction** as the action it records, so a lock
/// and its audit row commit or roll back together — the log can never disagree
/// with the decision. Rows are **retained** (never deleted with their subject):
/// `actorId` is nullable with onDelete: SetNull so an actor's account deletion
/// keeps the history, and `targetId` is a plain id (not an FK) since the target
/// option may be soft-deleted later. `metadata` carries a denormalized snapshot
/// (e.g. the option title) so the Phase-5 feed can render an event without
/// re-reading a since-changed subject. Phase 5 owns the read side.
model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  tripId     String      @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  targetType String
  targetId   String?     @db.Uuid
  metadata   Json?
  createdAt  DateTime    @default(now())

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  // The feed's only query: one trip's log, newest first (Phase 5.4). Paging is
  // keyset on (createdAt, id), so both columns belong in the index.
  @@index([tripId, createdAt, id])
  @@index([actorId])
  @@map("audit_events")
}

/// An approval-style, advisory vote on an option (SRS §6 / FR-22–23, Phase 2.3).
/// One row per user per option — a member may vote for **many** options in a
/// category (approval voting), and voting is **public** (the voter list is shown
/// on option read). Votes never decide anything; only a lock (Phase 2.4) records
/// a decision. Staleness is **not stored**: a vote is stale iff its `createdAt`
/// predates the option's `materialChangedAt` (decision 3), computed on read — a
/// material edit flags prior votes without deleting them (FR-23). The row is
/// hard-deleted on unvote; it cascades when the option row is truly removed (a
/// category hard-delete, FR-20) or the user is deleted.
model Vote {
  id        String   @id @default(uuid()) @db.Uuid
  optionId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One vote per user per option; casting is idempotent (upsert). The index
  // serves the per-option tally read (NFR-1, Phase-12 index audit).
  @@unique([optionId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("votes")
}

/// Invite-link kind (SRS FR-13). A GLOBAL link is reusable and disableable,
/// with at most one active link per role per trip (so at most 3/trip). A
/// PERSONAL link is single-use — `consumedAt` is stamped on first redemption —
/// and may optionally be emailed to an address (the link stays unbound, so a
/// forwarded personal link can be redeemed by the wrong person: accepted risk).
enum InviteType {
  GLOBAL
  PERSONAL
}

model TripMembership {
  id                String   @id @default(uuid()) @db.Uuid
  tripId            String   @db.Uuid
  userId            String   @db.Uuid
  role              TripRole
  joinedAt          DateTime @default(now())
  // Per-trip mute (Phase 5.2, FR-36): silences this trip's notification EMAIL
  // for this member without touching their global preference or the always-on
  // in-app bell. Lives on the membership so it dies with it.
  muted             Boolean  @default(false)
  // Where this trip sits in THIS member's overview (Phase: post-launch). Lives
  // on the membership rather than the trip because the order is one person's
  // view of their own list — two members of the same trip may quite reasonably
  // put it in different places, and nobody should be able to reorder anyone
  // else's home page by dragging a tile on theirs.
  //
  // Nullable, and null sorts last: an existing membership has never been
  // arranged, and a default of 0 would have claimed every one of them was
  // deliberately placed first. Only the tiles someone has actually dragged
  // carry a number, and the rest keep falling back to newest-first.
  sortOrder         Int?
  // Which invite link (if any) this member joined through. Provenance only; the
  // link may later be disabled/deleted without touching the membership, so it is
  // a nullable soft reference (onDelete: SetNull), not a hard FK.
  joinedViaInviteId String?  @db.Uuid

  trip      Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedVia InviteLink? @relation(fields: [joinedViaInviteId], references: [id], onDelete: SetNull)

  // One membership per user per trip; joining is idempotent (Phase 1.3).
  @@unique([tripId, userId])
  @@index([userId])
  @@index([joinedViaInviteId])
  @@map("trip_memberships")
}

/// A shareable invite link (SRS FR-13–16). The high-entropy `token` is the
/// bearer secret carried in the join URL; it is stored in the clear (unlike
/// hashed auth tokens) because a GLOBAL link must be re-displayable for copying,
/// and a leaked link only grants trip-join — an accepted, disableable risk. The
/// link carries the `role` granted on join (Guest/Participant/Co-organizer,
/// FR-14) and never OWNER. Disabling sets `disabledAt` (existing members are
/// retained); redeeming a PERSONAL link sets `consumedAt`.
model InviteLink {
  id          String     @id @default(uuid()) @db.Uuid
  tripId      String     @db.Uuid
  type        InviteType
  role        TripRole
  token       String     @unique
  // Optional address a PERSONAL link was emailed to (informational; the link
  // itself stays unbound — anyone holding the token can redeem it).
  sentToEmail String?
  createdById String     @db.Uuid
  disabledAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  trip              Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy         User             @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  joinedMemberships TripMembership[]

  @@index([tripId])
  @@index([createdById])
  @@map("invite_links")
}

/// A hard bar on a user rejoining a trip (SRS FR-17). Deliberately **independent
/// of membership**: blocking ejects the membership row *and* writes this row, so
/// the bar survives the ejection and no live invite link can let them back in.
/// Reversible by an Owner/Co-organizer (unblock deletes the row). `blockedById`
/// records who imposed it (audit/provenance).
model TripBlock {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @db.Uuid
  userId      String   @db.Uuid
  blockedById String   @db.Uuid
  createdAt   DateTime @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User @relation("BlockIssuer", fields: [blockedById], references: [id], onDelete: Cascade)

  // At most one active block per user per trip; the join path looks it up by this.
  @@unique([tripId, userId])
  @@index([userId])
  @@index([blockedById])
  @@map("trip_blocks")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Store a hash of the token, never the token itself — enables revocation
  // without ever persisting a usable credential.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Daily exchange-rate snapshot (post-launch), one row per currency.
///
/// Quoted as "units per one EUR" because that is how the reference source
/// publishes them; a trip converts into its own currency by crossing two rows,
/// so EUR is a pivot here and not a privileged destination.
///
/// Deliberately **not** a history table. The app offers one approximation of
/// what a trip roughly costs today; it does not reprice the past, and stored
/// option amounts are never touched by a refresh. Each refresh upserts in
/// place, and a failed refresh leaves the last good row exactly where it was.
model ExchangeRate {
  /// ISO 4217 code, e.g. "HUF". The pivot itself is not stored — it is 1.
  code      String   @id
  /// How many of this currency one EUR buys. Wide scale: a rate can be ~0.0000x.
  perEur    Decimal  @db.Decimal(20, 10)
  /// The source's own publication date — NOT when we fetched it. Rates publish
  /// on working days only, so a Sunday fetch carries Friday's date, and saying
  /// otherwise would claim a freshness that does not exist.
  asOf      DateTime @db.Date
  fetchedAt DateTime @default(now())
  /// Which feed it came from, so a wrong number can be traced to its origin.
  source    String

  @@map("exchange_rates")
}

/// An operator action taken from the admin console (post-launch).
///
/// Separate from {@link AuditEvent} because that one is trip-scoped: its
/// `tripId` is required and cascades from the trip, so an action against a user
/// account has nowhere to live in it, and its `AuditAction` enum describes trip
/// events only. Merging the two would have meant making `tripId` nullable —
/// weakening a guarantee that holds today for every row in that table — to
/// accommodate a different kind of event entirely.
///
/// **Nothing here references a live row.** The actor's email and the subject
/// are snapshotted strings, not foreign keys, so the record of "who marked this
/// account verified" survives both accounts being deleted. A log whose rows
/// vanish with their subject cannot answer the question it exists for.
model AdminAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  /// One of the shared `AdminAuditAction` values. Stored as text rather than a
  /// Postgres enum so adding an action later is not a migration on a type.
  action     String
  /// The operator's address at the time of the action.
  actorEmail String
  /// Who or what it was done to, in words (usually an email).
  subject    String?
  createdAt  DateTime @default(now())

  /// The console's only query: newest first.
  @@index([createdAt])
  @@map("admin_audit_events")
}

/// What kind of thing a place is, which is the only reason one table holds all
/// three: a destination is a city most of the time and legitimately a region
/// ("Tuscany") or a country ("Portugal") the rest of it, and a picker that
/// offered only cities would send those two back to free text.
enum PlaceKind {
  CITY
  REGION
  COUNTRY
}

/// A country, for the one field that pays for this table: its currency.
///
/// Two hundred and fifty rows, seeded from GeoNames' `countryInfo.txt`. The
/// create-trip form asks for a destination and then, separately, for a currency
/// — and having been told "Lisbon, Portugal" it can answer the second question
/// itself. That is the difference between a picker that is tidier than a text
/// box and one that is worth a table.
model Country {
  /// ISO-3166 alpha-2. Also what a flag emoji is computed from, at no storage.
  code         String  @id @db.Char(2)
  name         String
  /// ISO-4217, or null for the handful of territories GeoNames leaves blank.
  currencyCode String? @db.Char(3)

  places Place[]

  @@map("countries")
}

/// Somewhere a group can go.
///
/// Seeded, read-only, and **not** referenced by a foreign key from `Trip` — see
/// the note on `Trip.destinationPlaceId`. Roughly 74,000 rows: every populated
/// place over 5,000 people, every first-level administrative region, and every
/// country. The full GeoNames dump is 4.8 million, which is mostly hamlets
/// nobody plans a trip to.
///
/// Rebuilt from a committed dataset (`prisma/data/places.tsv.gz`) by
/// `pnpm places:seed`, never from the network at runtime — which is what keeps
/// the test suite and the deploy free of a dependency on GeoNames being up.
/// Data © GeoNames, CC BY 4.0.
model Place {
  /// GeoNames' own id, kept as the primary key: it is stable across dumps, so a
  /// re-seed next year updates rows instead of renumbering them.
  geonameId    Int                      @id
  kind         PlaceKind
  /// The canonical name, and the only one ever displayed.
  name         String
  /// The accent-stripped form, so "Malmo" finds Malmö.
  asciiName    String
  /// Up to five Latin-script alternates, pipe-separated. **Search keys only** —
  /// a Hungarian typing "Bécs" has to reach Vienna, and the board still says
  /// Vienna. Translating proper nouns per locale is a separate decision.
  altNames     String                   @default("")
  countryCode  String                   @db.Char(2)
  /// GeoNames' first-level administrative code, e.g. "16" for Tuscany within IT.
  /// Paired with `countryCode` it identifies the region row this place sits in.
  admin1Code   String                   @default("")
  /// The region's display name, denormalised onto its cities: it is on screen
  /// beside every one of them ("Springfield, Illinois") and joining a table to
  /// itself for a type-ahead is a cost paid on every keystroke.
  admin1Name   String?
  /// Cities only. A country is not a point, and the only thing coordinates were
  /// going to buy is a dot on a map.
  latitude     Float?
  longitude    Float?
  /// IANA zone. Stored from the start although nothing reads it yet: the
  /// itinerary currently renders an option's hours in the *reader's* zone, so a
  /// 07:15 tram in Lisbon shows as 08:15 in Budapest, and fixing that needs the
  /// trip to know its own clock. Derived for regions and countries from their
  /// most populous city, which is a heuristic and a stated one.
  timezone     String?
  /// Ranking only, never shown. Somebody typing "Paris" means the French one.
  population   Int                      @default(0)
  /// Everything a query may match, folded: lowercased and accent-stripped, with
  /// the name, the ascii form and the alternates run together. Built in the
  /// seeder rather than in SQL, because folding accents in Postgres means the
  /// `unaccent` extension and this app should not demand privileges of whatever
  /// database it is pointed at.
  searchText   String                   @default("")
  /// Generated by Postgres from `searchText` — see the migration. Prisma cannot
  /// express a generated column, so it is `Unsupported`: present in the schema
  /// so `migrate diff` stays quiet, never written and never selected.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, \"searchText\")"))

  country Country @relation(fields: [countryCode], references: [code])

  /// The type-ahead's indexes. The GIN index over `searchVector` is in the
  /// migration and not here, for the same reason the column is `Unsupported`.
  @@index([countryCode])
  @@index([searchVector], type: Gin)
  @@map("places")
}
