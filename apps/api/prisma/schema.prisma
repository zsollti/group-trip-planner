// Prisma schema.
// Phase 0.4 added the auth identity tables; Phase 1.1 adds the Trip +
// TripMembership spine. The rest of the domain (Category, Option, ...) lands in
// later phases as vertical slices. Table names are snake_case; app-facing IDs
// are UUIDs; secrets are stored hashed, never in the clear.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  displayName   String
  // Nullable: OAuth-only accounts (Google, Phase 1.0) have no local password.
  passwordHash  String?
  emailVerified Boolean   @default(false)
  // GDPR erasure (FR-6): set on anonymization; personal fields are purged.
  anonymizedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedTrips              Trip[]                   @relation("TripOwner")
  memberships             TripMembership[]
  createdInvites          InviteLink[]             @relation("InviteCreator")
  blocks                  TripBlock[]              @relation("BlockedUser")
  blocksIssued            TripBlock[]              @relation("BlockIssuer")

  @@map("users")
}

/// Role hierarchy within a trip: Owner > Co-organizer > Participant > Guest
/// (SRS §3). Visitor is NOT a role — it is the unauthenticated public-preview
/// scope and has no membership row.
enum TripRole {
  OWNER
  CO_ORGANIZER
  PARTICIPANT
  GUEST
}

/// Active trips accept planning mutations; History trips are frozen (the
/// lifecycle transition itself lands in Phase 2).
enum TripStatus {
  ACTIVE
  HISTORY
}

/// Stable identity for a seeded built-in category (Phase 2.1). Categories are
/// renamable and deletable (FR-18), so `name` can neither identify the Dates
/// category for date write-back (Phase 2.5) nor drive the default `singleChoice`
/// flag — `builtinKey` survives a rename and is null for custom categories.
enum CategoryBuiltinKey {
  DATES
  TRANSPORT
  ACCOMMODATION
  ACTIVITIES
  BUDGET
}

model Trip {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  destination     String?
  // The safe upload pipeline is Phase 6; the column exists now so nothing has
  // to be retrofitted. Always null until then.
  coverImageUrl   String?
  defaultCurrency String     @default("EUR")
  // Dates are written back when a Dates-category option is locked (Phase 2);
  // until then a trip carries no dates and the created+1yr `expiresAt` fallback.
  startDate       DateTime?  @db.Date
  endDate         DateTime?  @db.Date
  expiresAt       DateTime
  status          TripStatus @default(ACTIVE)
  // Denormalized owner (SRS §6). The owner also holds an OWNER membership row;
  // both are written in one transaction at creation.
  ownerId         String     @db.Uuid
  // Optimistic-concurrency token for the "changed since you opened it — reload"
  // edit path (SRS §6). Bumped on every trip-detail edit.
  version         Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner       User             @relation("TripOwner", fields: [ownerId], references: [id])
  memberships TripMembership[]
  invites     InviteLink[]
  blocks      TripBlock[]
  categories  Category[]

  @@index([ownerId])
  @@map("trips")
}

/// A planning category within a trip (SRS §6, Phase 2.1). A trip is seeded with
/// five built-ins at creation (Dates, Transport, Accommodation, Activities,
/// Budget); Organizers may add custom ones. `singleChoice` means locking one
/// option unlocks its siblings (FR-19) — the category-level lock in Phase 2.4 is
/// serialized by `version`. Deleting a category hard-cascades its options, votes,
/// and (Phase 4) chat channel (FR-20). `position` orders the categories.
model Category {
  id           String              @id @default(uuid()) @db.Uuid
  tripId       String              @db.Uuid
  name         String
  // Single-choice categories (e.g. Dates) allow only one locked option at a
  // time; multi-select (e.g. Transport) allow many. FR-19.
  singleChoice Boolean             @default(false)
  // True for the five seeded built-ins; they are renamable/reorderable but the
  // key below preserves their identity for date write-back (Phase 2.5).
  isBuiltin    Boolean             @default(false)
  builtinKey   CategoryBuiltinKey?
  position     Int
  // Optimistic-concurrency token. Rename uses it for the "changed since you
  // opened it — reload" path; the Phase-2.4 single-choice lock guards on it to
  // serialize the one-decision-per-category race (FR-24).
  version      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // A trip has at most one category per built-in key (the seed is idempotent by
  // construction); custom categories carry a null key and are unconstrained.
  @@unique([tripId, builtinKey])
  @@index([tripId])
  @@map("categories")
}

/// Invite-link kind (SRS FR-13). A GLOBAL link is reusable and disableable,
/// with at most one active link per role per trip (so at most 3/trip). A
/// PERSONAL link is single-use — `consumedAt` is stamped on first redemption —
/// and may optionally be emailed to an address (the link stays unbound, so a
/// forwarded personal link can be redeemed by the wrong person: accepted risk).
enum InviteType {
  GLOBAL
  PERSONAL
}

model TripMembership {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TripRole
  joinedAt DateTime @default(now())
  // Which invite link (if any) this member joined through. Provenance only; the
  // link may later be disabled/deleted without touching the membership, so it is
  // a nullable soft reference (onDelete: SetNull), not a hard FK.
  joinedViaInviteId String? @db.Uuid

  trip         Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedVia    InviteLink? @relation(fields: [joinedViaInviteId], references: [id], onDelete: SetNull)

  // One membership per user per trip; joining is idempotent (Phase 1.3).
  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_memberships")
}

/// A shareable invite link (SRS FR-13–16). The high-entropy `token` is the
/// bearer secret carried in the join URL; it is stored in the clear (unlike
/// hashed auth tokens) because a GLOBAL link must be re-displayable for copying,
/// and a leaked link only grants trip-join — an accepted, disableable risk. The
/// link carries the `role` granted on join (Guest/Participant/Co-organizer,
/// FR-14) and never OWNER. Disabling sets `disabledAt` (existing members are
/// retained); redeeming a PERSONAL link sets `consumedAt`.
model InviteLink {
  id         String     @id @default(uuid()) @db.Uuid
  tripId     String     @db.Uuid
  type       InviteType
  role       TripRole
  token      String     @unique
  // Optional address a PERSONAL link was emailed to (informational; the link
  // itself stays unbound — anyone holding the token can redeem it).
  sentToEmail String?
  createdById String    @db.Uuid
  disabledAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User             @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  joinedMemberships TripMembership[]

  @@index([tripId])
  @@map("invite_links")
}

/// A hard bar on a user rejoining a trip (SRS FR-17). Deliberately **independent
/// of membership**: blocking ejects the membership row *and* writes this row, so
/// the bar survives the ejection and no live invite link can let them back in.
/// Reversible by an Owner/Co-organizer (unblock deletes the row). `blockedById`
/// records who imposed it (audit/provenance).
model TripBlock {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @db.Uuid
  userId      String   @db.Uuid
  blockedById String   @db.Uuid
  createdAt   DateTime @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User @relation("BlockIssuer", fields: [blockedById], references: [id], onDelete: Cascade)

  // At most one active block per user per trip; the join path looks it up by this.
  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_blocks")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  // Store a hash of the token, never the token itself — enables revocation
  // without ever persisting a usable credential.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
