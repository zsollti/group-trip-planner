{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",

    // NestJS relies on legacy decorators + reflected parameter types for DI.
    // tsc is the compiler here precisely because it can emit this metadata
    // (esbuild/node type-stripping cannot).
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"]
}
