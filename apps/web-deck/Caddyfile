# Serves the built Vite SPA. Railway provides $PORT; fall back to 80 locally.
:{$PORT:80} {
	root * /srv
	encode gzip

	# SPA history fallback: serve real files if they exist, else hand every
	# route to index.html so React Router resolves it client-side.
	try_files {path} /index.html
	file_server

	# Long-cache the fingerprinted assets; never cache the HTML entrypoint.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
